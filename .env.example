# Copia este archivo como .env.local y llena los valores. (.env.local NO se sube a GitHub.)
# En desarrollo, `npm run db:local` crea .env.local por ti con una base local.

# Conexión a PostgreSQL (con pooler si tu proveedor lo ofrece)
DATABASE_URL=postgresql://usuario:contraseña@servidor:5432/basededatos?sslmode=require

# Conexión DIRECTA (sin "pooler"). Necesaria en Neon/Supabase para las alertas en vivo (LISTEN/NOTIFY).
# En Vercel + Neon se llama DATABASE_URL_UNPOOLED y la integración la crea sola (cualquiera de los dos nombres sirve).
# DATABASE_URL_DIRECT=postgresql://usuario:contraseña@servidor-directo:5432/basededatos?sslmode=require

# Dominio público al que apuntan los QR impresos (en producción).
# PUBLIC_BASE_URL=https://mesa.tudominio.mx

# Opcional: clave para firmar cookies. Si no la defines, se genera y se guarda en la base.
# AUTH_SECRET=

# Solo para pruebas en tu red local (IP de tu PC):
# DEV_ORIGINS=192.168.1.156
