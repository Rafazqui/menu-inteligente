{
  "name": "mesa-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/migrar-sqlite-a-postgres.mts",
    "db:local": "node scripts/db-local.mjs",
    "usuario:clave": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/cambiar-clave.mts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.18",
